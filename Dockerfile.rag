FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    && rm -rf /var/lib/apt/lists/*

COPY rag_interview/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY rag_interview/ ./rag_interview/
COPY *.html ./

WORKDIR /app/rag_interview

EXPOSE 8100

CMD ["python", "-m", "uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8100", "--workers", "2"]
